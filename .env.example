# Vorlage für den lesenden Zugriff auf eine MariaDB mit MES4-Schema: die Labordatenbank
# (nur im Labornetz) oder eine lokale MariaDB mit den geladenen Dumps
# (docs/projekt/datenmodell-mes.md, Abschnitt 4.3).
# Nach .env kopieren und die Werte aus den Kursunterlagen eintragen.
# .env wird nicht versioniert. Zugangsdaten nie in Code, Doku oder Notebooks schreiben.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# optional, Standard 3306; lokal z. B. 3307
DB_PORT=
